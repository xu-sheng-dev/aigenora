{
  "name": "Coin Flip",
  "spec_version": "1.0",
  "description": "Best-of-N Coin Flip with engine-managed SHA256 commit-reveal fairness (simultaneous_round mode)",
  "type": "game",
  "family": "coin-flip",
  "flow": {
    "mode": "simultaneous_round",
    "round": {
      "value_field": "choice",
      "value_type_ref": "reveal.fields.choice"
    },
    "phases": [
      {
        "phase": "join",
        "exchange": [
          {
            "message": "join",
            "direction": "guest_to_host"
          },
          {
            "message": "ready",
            "direction": "host_to_guest"
          }
        ]
      },
      {
        "phase": "round",
        "repeat": "best_of",
        "exchange": [
          {
            "message": "commit",
            "direction": "host_to_guest"
          },
          {
            "message": "commit",
            "direction": "guest_to_host"
          },
          {
            "message": "reveal",
            "direction": "host_to_guest"
          },
          {
            "message": "reveal",
            "direction": "guest_to_host"
          },
          {
            "message": "round_result",
            "direction": "host_to_guest"
          }
        ]
      }
    ]
  },
  "messages": [
    {
      "name": "join",
      "direction": "guest_to_host",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "join"
          ],
          "required": true
        },
        "best_of": {
          "type": "integer",
          "min": 1,
          "max": 99,
          "required": false
        }
      }
    },
    {
      "name": "ready",
      "direction": "host_to_guest",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "ready"
          ],
          "required": true
        },
        "best_of": {
          "type": "integer",
          "required": true
        },
        "rounds_to_win": {
          "type": "integer",
          "required": true
        }
      }
    },
    {
      "name": "commit",
      "direction": "both",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "commit"
          ],
          "required": true
        },
        "round": {
          "type": "integer",
          "min": 0,
          "required": true
        },
        "hash": {
          "type": "hash",
          "required": true
        }
      }
    },
    {
      "name": "reveal",
      "direction": "both",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "reveal"
          ],
          "required": true
        },
        "round": {
          "type": "integer",
          "min": 0,
          "required": true
        },
        "choice": {
          "type": "enum",
          "values": [
            "heads",
            "tails"
          ],
          "required": true
        },
        "nonce": {
          "type": "nonce",
          "required": true
        }
      }
    },
    {
      "name": "round_result",
      "direction": "host_to_guest",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "round_result"
          ],
          "required": true
        },
        "round": {
          "type": "integer",
          "min": 0,
          "required": true
        },
        "host_choice": {
          "type": "enum",
          "values": [
            "heads",
            "tails"
          ],
          "required": true
        },
        "guest_choice": {
          "type": "enum",
          "values": [
            "heads",
            "tails"
          ],
          "required": true
        },
        "round_winner": {
          "type": "enum",
          "values": [
            "host",
            "guest"
          ],
          "required": true
        },
        "host_wins": {
          "type": "integer",
          "min": 0,
          "required": true
        },
        "guest_wins": {
          "type": "integer",
          "min": 0,
          "required": true
        },
        "game_over": {
          "type": "boolean",
          "required": true
        },
        "game_winner": {
          "type": "enum",
          "values": [
            "host",
            "guest",
            "none"
          ],
          "required": true
        }
      }
    },
    {
      "name": "error",
      "direction": "host_to_guest",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "error"
          ],
          "required": true
        },
        "round": {
          "type": "integer",
          "min": 0
        },
        "reason": {
          "type": "enum",
          "values": [
            "timeout",
            "invalid_choice",
            "aborted",
            "commit_mismatch"
          ],
          "required": true
        }
      }
    },
    {
      "name": "end",
      "direction": "host_to_guest",
      "fields": {
        "action": {
          "type": "enum",
          "values": [
            "end"
          ],
          "required": true
        }
      }
    }
  ],
  "rules": {
    "setup": "Both sides commit a side; if same side, host wins; if different, guest wins.",
    "win_conditions": "guest wins iff guest_choice == host_choice (in classic coin-flip, caller wins on match; here we adopt match-wins-guest convention)",
    "game_over": "First to reach rounds_to_win wins."
  },
  "choices": [
    "heads",
    "tails"
  ],
  "parameters": {
    "best_of": {
      "type": "integer",
      "min": 1,
      "max": 99
    },
    "min_think_seconds": {
      "type": "integer",
      "min": 0,
      "max": 60
    },
    "max_think_seconds": {
      "type": "integer",
      "min": 1,
      "max": 600
    }
  },
  "decision": {
    "mode": "auto",
    "timeout_seconds": 120,
    "timeout_action": "fallback"
  },
  "timing": {
    "mode": "simultaneous",
    "min_think_seconds": 1,
    "max_think_seconds": 3
  }
}