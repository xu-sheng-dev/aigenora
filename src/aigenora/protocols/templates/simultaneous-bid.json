{
  "spec_version": "1.0",
  "name": "__REQUIRED_NAME__",
  "description": "Simultaneous sealed-bid template: both sides commit a hidden value then reveal, with engine-managed SHA256 commit-reveal fairness (simultaneous_round mode). Replace option_a/option_b with your real bid options.",
  "type": "supply",
  "family": "__REQUIRED_FAMILY__",
  "flow": {
    "mode": "simultaneous_round",
    "round": {
      "value_field": "value",
      "value_type_ref": "reveal.fields.value"
    },
    "phases": [
      {
        "phase": "join",
        "exchange": [
          {"message": "join", "direction": "guest_to_host"},
          {"message": "ready", "direction": "host_to_guest"}
        ]
      },
      {
        "phase": "round",
        "repeat": "best_of",
        "exchange": [
          {"message": "commit", "direction": "host_to_guest"},
          {"message": "commit", "direction": "guest_to_host"},
          {"message": "reveal", "direction": "host_to_guest"},
          {"message": "reveal", "direction": "guest_to_host"},
          {"message": "round_result", "direction": "host_to_guest"}
        ]
      }
    ]
  },
  "messages": [
    {
      "name": "join",
      "direction": "guest_to_host",
      "fields": {
        "action": {"type": "enum", "values": ["join"], "required": true},
        "best_of": {"type": "integer", "min": 1, "max": 99, "required": true}
      }
    },
    {
      "name": "ready",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["ready"], "required": true},
        "best_of": {"type": "integer", "required": true},
        "rounds_to_win": {"type": "integer", "required": true}
      }
    },
    {
      "name": "commit",
      "direction": "both",
      "fields": {
        "action": {"type": "enum", "values": ["commit"], "required": true},
        "round": {"type": "integer", "min": 0, "required": true},
        "hash": {"type": "hash", "required": true}
      }
    },
    {
      "name": "reveal",
      "direction": "both",
      "fields": {
        "action": {"type": "enum", "values": ["reveal"], "required": true},
        "round": {"type": "integer", "min": 0, "required": true},
        "value": {"type": "enum", "values": ["option_a", "option_b"], "required": true},
        "nonce": {"type": "nonce", "required": true}
      }
    },
    {
      "name": "round_result",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["round_result"], "required": true},
        "round": {"type": "integer", "min": 0, "required": true},
        "host_value": {"type": "enum", "values": ["option_a", "option_b"], "required": true},
        "guest_value": {"type": "enum", "values": ["option_a", "option_b"], "required": true},
        "round_winner": {"type": "enum", "values": ["host", "guest", "draw"], "required": true},
        "host_wins": {"type": "integer", "min": 0, "required": true},
        "guest_wins": {"type": "integer", "min": 0, "required": true},
        "game_over": {"type": "boolean", "required": true},
        "game_winner": {"type": "enum", "values": ["host", "guest", "draw", "none"], "required": true}
      }
    },
    {
      "name": "error",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["error"], "required": true},
        "round": {"type": "integer", "min": 0},
        "reason": {"type": "enum", "values": ["timeout", "invalid_value", "aborted", "commit_mismatch"], "required": true}
      }
    }
  ],
  "rules": {
    "fairness": "Engine-managed commit-reveal: hash = SHA256(value:nonce). A reveal that does not match its commit hash aborts the round.",
    "game_over": "Set game_over=true when one side reaches rounds_to_win, or after best_of rounds (higher wins; equal is a draw)."
  },
  "choices": ["option_a", "option_b"],
  "parameters": {
    "best_of": {"type": "integer", "min": 1, "max": 99}
  }
}
