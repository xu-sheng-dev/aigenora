{
  "spec_version": "1.0",
  "name": "__REQUIRED_NAME__",
  "description": "Turn-based game template with bounded enum decisions and explicit result messages.",
  "type": "game",
  "family": "__REQUIRED_FAMILY__",
  "messages": [
    {
      "name": "join",
      "direction": "guest_to_host",
      "fields": {
        "action": {"type": "enum", "values": ["join"], "required": true},
        "rounds": {"type": "integer", "min": 1, "max": 99, "required": true}
      }
    },
    {
      "name": "ready",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["ready"], "required": true},
        "rounds": {"type": "integer", "min": 1, "max": 99, "required": true}
      }
    },
    {
      "name": "move",
      "direction": "guest_to_host",
      "fields": {
        "action": {"type": "enum", "values": ["move"], "required": true},
        "round": {"type": "integer", "min": 1, "required": true},
        "choice": {"type": "enum", "values": ["option_a", "option_b"], "required": true}
      }
    },
    {
      "name": "round_result",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["round_result"], "required": true},
        "round": {"type": "integer", "min": 1, "required": true},
        "winner": {"type": "enum", "values": ["host", "guest", "draw"], "required": true},
        "game_over": {"type": "boolean", "required": true},
        "game_winner": {"type": "enum", "values": ["host", "guest", "none"], "required": true}
      }
    },
    {
      "name": "error",
      "direction": "both",
      "fields": {
        "action": {"type": "enum", "values": ["error"], "required": true},
        "code": {"type": "enum", "values": ["invalid_message", "timeout", "forfeit"], "required": true}
      }
    }
  ],
  "flow": {
    "phases": [
      {
        "phase": "join",
        "exchange": [
          {"message": "join", "direction": "guest_to_host"},
          {"message": "ready", "direction": "host_to_guest"}
        ]
      },
      {
        "phase": "round",
        "repeat": "total_rounds",
        "exchange": [
          {"message": "move", "direction": "guest_to_host"},
          {"message": "round_result", "direction": "host_to_guest"}
        ]
      }
    ]
  },
  "rules": {
    "game_over": "Define exactly when game_over becomes true and how game_winner is chosen.",
    "timeout": "If a player misses a turn timeout, send error code timeout or forfeit."
  },
  "choices": ["option_a", "option_b"],
  "parameters": {
    "rounds": {"type": "integer", "min": 1, "max": 99}
  }
}
