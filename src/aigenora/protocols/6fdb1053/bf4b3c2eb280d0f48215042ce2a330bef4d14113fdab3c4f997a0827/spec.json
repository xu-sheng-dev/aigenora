{
  "name": "Gomoku (Five-in-a-Row)",
  "spec_version": "1.0",
  "description": "1v1 full-information board game. Players alternate placing stones on an NxN board; first to line up five in a row (horizontal/vertical/diagonal) wins. session_loop ping-pong with hooks-side board state.",
  "type": "game",
  "messages": [
    {
      "name": "join",
      "direction": "guest_to_host",
      "fields": {
        "action": {"type": "enum", "values": ["join"], "required": true},
        "board_size": {"type": "integer", "min": 5, "max": 19, "required": false}
      }
    },
    {
      "name": "ready",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["ready"], "required": true},
        "board_size": {"type": "integer", "required": true},
        "first": {"type": "enum", "values": ["guest"], "required": true}
      }
    },
    {
      "name": "move",
      "direction": "guest_to_host",
      "fields": {
        "action": {"type": "enum", "values": ["move"], "required": true},
        "turn": {"type": "integer", "min": 1, "required": true},
        "row": {"type": "integer", "min": 0, "max": 18, "required": true},
        "col": {"type": "integer", "min": 0, "max": 18, "required": true}
      }
    },
    {
      "name": "round_result",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["round_result"], "required": true},
        "turn": {"type": "integer", "min": 1, "required": true},
        "row": {"type": "integer", "min": 0, "max": 18, "required": true},
        "col": {"type": "integer", "min": 0, "max": 18, "required": true},
        "player": {"type": "enum", "values": ["host", "guest"], "required": true},
        "game_over": {"type": "boolean", "required": true},
        "winner": {"type": "enum", "values": ["host", "guest", "none"], "required": true}
      }
    },
    {
      "name": "error",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["error"], "required": true},
        "turn": {"type": "integer", "min": 1},
        "reason": {"type": "enum", "values": ["out_of_bounds", "occupied", "board_full", "not_your_turn"], "required": true}
      }
    },
    {
      "name": "end",
      "direction": "host_to_guest",
      "fields": {
        "action": {"type": "enum", "values": ["end"], "required": true},
        "winner": {"type": "enum", "values": ["host", "guest", "draw"], "required": true}
      }
    }
  ],
  "flow": {
    "mode": "session_loop",
    "phases": [
      {
        "phase": "join",
        "exchange": [
          {"message": "join", "direction": "guest_to_host"},
          {"message": "ready", "direction": "host_to_guest"}
        ]
      },
      {
        "phase": "play",
        "repeat": "until game_over",
        "exchange": [
          {"message": "move", "direction": "guest_to_host"},
          {"message": "round_result", "direction": "host_to_guest"}
        ]
      },
      {
        "phase": "end",
        "exchange": [
          {"message": "end", "direction": "host_to_guest"}
        ]
      }
    ]
  },
  "rules": {
    "setup": "Empty NxN board (default N=15). Guest plays Black (first), Host plays White (second).",
    "turn": "Guest sends a move (row,col); host records it, plays its own move, and returns a round_result carrying host's stone plus a win check.",
    "win": "First to align five stones consecutively in a row, column, or diagonal wins immediately.",
    "draw": "Board full with no five-in-a-row => draw."
  },
  "parameters": {
    "board_size": {"type": "integer", "min": 5, "max": 19},
    "min_think_seconds": {"type": "integer", "min": 0, "max": 60},
    "max_think_seconds": {"type": "integer", "min": 1, "max": 600}
  },
  "decision": {
    "mode": "auto",
    "timeout_seconds": 120,
    "timeout_action": "fallback"
  },
  "timing": {
    "mode": "sequential",
    "min_think_seconds": 1,
    "max_think_seconds": 3
  }
}
